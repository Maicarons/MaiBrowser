{
  "name": "@maibrowser/desktop",
  "version": "0.1.2",
  "type": "module",
  "main": "main.js",
  "scripts": {
    "dev": "cross-env NODE_ENV=development concurrently -k --prefix none \"rspeedy dev --environment lynx\" \"dev-ready-rspeedy && rsbuild dev --environment desktop\"",
    "build": "rspeedy build --environment lynx && rsbuild build --environment desktop",
    "start": "bun run build && lynxtron dist/desktop",
    "dev:web": "cross-env NODE_ENV=development concurrently -k --prefix node \"rspeedy dev --environment web\" \"dev-ready-rspeedy && rsbuild dev --environment web\"",
    "build:web": "rspeedy build --environment web && rsbuild build --environment web",
    "start:web": "bun run build:web && bunx serve dist/web",
    "test": "bun test src/main/desktop/duckdb.test.ts",
    "pack": "bun run build && lynxtron-builder --publish never",
    "typecheck": "tsc -p src/app/tsconfig.json --noEmit && tsc -p src/main/desktop/tsconfig.json --noEmit"
  },
  "private": true,
  "devDependencies": {
    "@lynx-js/config-rsbuild-plugin": "0.3.0",
    "@lynx-js/css-serializer": "0.1.9",
    "@lynx-js/lynx-core": "0.1.4",
    "@lynx-js/lynxtron": "0.0.31",
    "@lynx-js/lynxtron-builder": "0.0.30",
    "@lynx-js/lynxtron-dev-plugins": "0.0.31",
    "@lynx-js/react": "0.129.4",
    "@lynx-js/react-rsbuild-plugin": "0.22.3",
    "@lynx-js/rspeedy": "0.18.6",
    "@lynx-js/type-config": "4.4.0",
    "@lynx-js/types": "4.4.2",
    "@lynx-js/web-core": "0.26.8",
    "@lynx-js/web-elements": "0.12.18",
    "@rsbuild/core": "2.2.9",
    "@rsbuild/plugin-type-check": "1.6.1",
    "@rstest/core": "^0.11.1",
    "@types/node": "^25.0.3",
    "@types/react": "^18.3.24",
    "compressing": "^1.10.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "jsdom": "^26.1.0",
    "tslib": "^2.8.1",
    "typescript": "~5.9.3",
    "@maibrowser/core": "workspace:*",
    "@maibrowser/engine-contract": "workspace:*",
    "@maibrowser/i18n": "workspace:*",
    "@maibrowser/storage": "workspace:*",
    "@maibrowser/ui": "workspace:*",
    "@maibrowser/userscript": "workspace:*",
    "@lynx-js/lynx-ui": "3.143.0"
  },
  "engines": {
    "node": ">=22.18.0"
  },
  "dependencies": {
    "@duckdb/node-api": "2.0.1-r.1",
    "@lynx-js/cef-webview": "0.0.31",
    "@lynx-js/motion": "0.0.8"
  },
  "description": "MaiBrowser desktop browser (Windows, Lynxtron + CEF)",
  "author": "MaiBrowser contributors"
}
